# ── COPIA ESTE ARCHIVO COMO .env ─────────────────────────────
# Renombra este archivo a ".env" en la carpeta backend/

# ── Base de datos LOCAL (PostgreSQL instalado en esta PC) ─────
DATABASE_URL="postgresql://postgres:TU_PASSWORD_POSTGRES@localhost:5432/refaccionaria"

# ── Servidor ──────────────────────────────────────────────────
PORT=4000
NODE_ENV=production

# ── JWT — cambia esto por una frase secreta larga ─────────────
JWT_SECRET=mi_taller_clave_super_secreta_2024_cambiar_esto

# ── URL del frontend (mismo servidor, misma PC) ───────────────
FRONTEND_URL=http://localhost:4000

# ── IA — Asistente de diagnóstico (opcional) ──────────────────
# Si no tienes clave de Anthropic, deja esto vacío o quítalo
ANTHROPIC_API_KEY=

# ── CFDI / Facturama (opcional — solo si facturas) ────────────
# Si no usas facturación electrónica, deja esto vacío
FACTURAMA_USER=
FACTURAMA_PASS=
FACTURAMA_SANDBOX=true
